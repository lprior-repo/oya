cabal-version:      3.0
name:               haskell-api
version:            0.1.0.0
synopsis:           REST API built with Scotty
homepage:           https://github.com/lprior-repo/oya
license:            MIT
author:             Lewis
maintainer:         lewis@example.com
category:           Web
build-type:         Simple

executable haskell-api
    main-is:            Main.hs
    build-depends:
        base >=4.14 && <5,
        scotty >=0.12,
        aeson >=1.5,
        text >=1.2,
        http-types >=0.12,
        wai >=3.2,
        warp >=3.3,
        containers >=0.6,
        mtl >=2.2
    hs-source-dirs:     app
    default-language:   Haskell2010
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-export-lists
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints

test-suite haskell-api-test
    type:               exitcode-stdio-1.0
    main-is:            Spec.hs
    build-depends:
        base >=4.14 && <5,
        scotty >=0.12,
        aeson >=1.5,
        text >=1.2,
        http-types >=0.12,
        wai >=3.2,
        warp >=3.3,
        containers >=0.6,
        mtl >=2.2,
        hspec >=2.7,
        hspec-wai >=0.11,
        hspec-wai-json >=0.10
    hs-source-dirs:     app, test
    default-language:   Haskell2010
