# CORRECT PATTERN Fixed
correct_title: {
  label: CORRECT PATTERN Fixed
  style.stroke-width: 3
  style.bold: true
}

correct_spawn: {
  label: tokio task spawn_blocking outside ctx.run
  style.stroke-width: 2
}

correct_capture: {
  label: Result captured in variable
}

correct_ctx: {
  label: ctx.run with transformation only
}

